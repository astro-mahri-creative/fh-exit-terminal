# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/exit-terminal?retryWrites=true&w=majority

# Server Port
PORT=5000

# Email Service (Gmail SMTP via App Password)
# 1. Enable 2FA on the Google account
# 2. Go to Google Account → Security → App Passwords → generate one for "Mail"
# 3. Paste the 16-char app password below (no spaces)
GMAIL_USER=you@yourdomain.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# ── Alternative email providers (pick ONE of the blocks below) ──
# Generic SMTP (preferred — works with Mailgun, SES, Postmark, etc.)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=apikey-or-username
# EMAIL_PASSWORD=secret
#
# SendGrid (API key only; EMAIL_FROM must be a verified sender)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
#
# Display/from address used by every outbound message
# EMAIL_FROM=terminal@yourdomain.com

# ── Final-state alerts ──
# Fired once per phase, the moment every universe locks into a permanent
# status (TRANSCENDED or QUARANTINED). Leave blank to disable a channel.
# Comma-separated list of operator addresses to notify.
# FINAL_STATE_ALERT_EMAIL=you@yourdomain.com,teammate@yourdomain.com
# Any endpoint that accepts a JSON POST (Slack/Discord incoming webhook,
# Zapier, Make, your own service).
# FINAL_STATE_WEBHOOK_URL=https://hooks.example.com/services/xxx
